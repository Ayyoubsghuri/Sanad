# All settings use the LEGALRAG_ prefix. API keys are NOT set here: store them with PUT /v1/secrets/{name} (OS keychain).
LEGALRAG_HOST=127.0.0.1
LEGALRAG_PORT=8765
# LEGALRAG_API_TOKEN=            # generated and persisted on first run when unset
# LEGALRAG_DATA_DIR=~/.moroccan-legal-rag
# LEGALRAG_LAWPACK_PATH=         # default: <data_dir>/lawpack/current.db
# LEGALRAG_LAWPACK_PUBLIC_KEY_HEX=   # publisher Ed25519 public key; packs failing verification are refused
# LEGALRAG_ALLOW_UNSIGNED_PACK=false # development only
